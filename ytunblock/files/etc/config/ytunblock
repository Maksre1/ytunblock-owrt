config ytunblock 'ytunblock'
	option enabled '1'
	option conf_strat 'ui_flags'
	option queue_num '537'
	option packet_mark '32768'
	option threads '1'
	option no_gso '1'
	option no_ipv6 '0'
	option silent '0'
	option trace '0'
	option post_args ''
	option schema_version '2'

config section
	option name 'YouTube'
	option enabled '1'
	option tls_enabled '1'
	option all_domains '0'
	option sni_detection 'parse'
	option fake_sni '1'
	option fake_sni_seq_len '1'
	option fake_sni_type 'default'
	option faking_strategy 'pastseq'
	option faking_ttl '8'
	option fake_seq_offset '10000'
	option frag 'tcp'
	option frag_sni_reverse '1'
	option frag_sni_faked '0'
	option frag_middle_sni '1'
	option frag_sni_pos '1'
	option seg2delay '0'
	option fk_winsize '0'
	option synfake '0'
	option synfake_len '0'
	option quic_drop '1'
	option udp_mode 'drop'
	option udp_faking_strategy 'none'
	option udp_fake_seq_len '6'
	option udp_fake_len '64'
	option udp_filter_quic 'all'
	option udp_stun_filter '0'
	option section_post_args ''
	list exclude_domains 'ru'
	list exclude_domains 'gov'
	list sni_domains 'youtube.com'
	list sni_domains 'www.youtube.com'
	list sni_domains 'm.youtube.com'
	list sni_domains 'music.youtube.com'
	list sni_domains 'youtu.be'
	list sni_domains 'youtubei.googleapis.com'
	list sni_domains 'youtube.googleapis.com'
	list sni_domains 'youtube-nocookie.com'
	list sni_domains 'googlevideo.com'
	list sni_domains 'ytimg.com'
	list sni_domains 'i.ytimg.com'
	list sni_domains 'ggpht.com'
	list sni_domains 'yt3.ggpht.com'
	list sni_domains 'yt4.ggpht.com'
	list sni_domains 'googleapis.com'
	list sni_domains 'googleusercontent.com'
	list sni_domains 'gstatic.com'
	list sni_domains 'l.google.com'
	list sni_domains 'play.google.com'
