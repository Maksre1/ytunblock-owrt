#!/usr/sbin/nft -f
# ytunblock — правила для firewall4 (OpenWrt 23.x / 25.x)

add chain inet fw4 ytunblock { type filter hook postrouting priority mangle - 1; policy accept; }
add rule inet fw4 ytunblock tcp dport 443 ct original packets < 20 counter queue num 537 bypass
add rule inet fw4 ytunblock meta l4proto udp ct original packets < 9 counter queue num 537 bypass
insert rule inet fw4 output mark and 0x8000 == 0x8000 counter accept
